          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "read_farm_data",
        "title": "Læs gårdens data",
        "description": "Læs og filtrer rækker fra Eriksmindes tabeller. Understøtter lighedsfiltre, valg af kolonner, sortering, datointerval og tekstsøgning. Tabeller: fields (Marker (areal, afgrøde, forpagtningsareal)), parcels (Matrikler), field_parcels (Kobling mellem marker og matrikler), land_leases (Forpagtningsaftaler for jord), buildings (Bygninger og udlejningspotentiale), building_units (Bygningsenheder), building_leases (Lejeaftaler for bygninger), hunting_leases (Jagtlejeaftaler), straw_inventory (Halmlager), straw_movements (Halmsalg og -bevægelser), tasks (Opgaver), maintenance_tasks (Vedligehold), machines (Maskiner), contacts (Kunder og leverandører), invoices (Fakturakladder), budget_scenarios (Budgetter pr. år), budget_lines (Budgetlinjer (indtægter/udgifter, månedsfordeling)), budget_loans (Lån i budgettet), forest_parcels (Skovarealer), forest_activities (Skovaktiviteter (hugst m.m.)).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "enum": [
                "fields",
                "parcels",
                "field_parcels",
                "land_leases",
                "buildings",
                "building_units",
                "building_leases",
                "hunting_leases",
                "straw_inventory",
                "straw_movements",
                "tasks",
                "maintenance_tasks",
                "machines",
                "contacts",
                "invoices",
                "budget_scenarios",
                "budget_lines",
                "budget_loans",
                "forest_parcels",
                "forest_activities"
              ],
              "description": "Tabellen der skal læses."
            },
            "limit": {
              "description": "Maks antal rækker (standard 200).",
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "filters": {
              "description": "Lighedsfiltre, fx {\"lease_status\":\"ledig\"}.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1000
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "columns": {
              "description": "Kolonner der returneres; standard er alle.",
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
              }
            },
            "order_by": {
              "description": "Kolonne der sorteres efter.",
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
            },
            "ascending": {
              "description": "Stigende sortering; standard er sand.",
              "type": "boolean"
            },
            "date_from": {
              "description": "Fra og med dato på tabellens primære datokolonne.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "date_to": {
              "description": "Til og med dato på tabellens primære datokolonne.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "search": {
              "description": "Søg i tabellens name-, title- og description-felter, hvor de findes.",
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "table"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
